<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.jerryt92.j2agent.mapper.ext.AuditChatContextExtMapper">

  <sql id="Context_Where">
    <where>
      <if test="userId != null and userId != ''">
        and user_id = #{userId}
      </if>
      <if test="title != null and title != ''">
        and title like concat('%', #{title}, '%')
      </if>
      <if test="agentId != null and agentId != ''">
        and agent_id = #{agentId}
      </if>
      <if test="fromTime != null">
        and update_time &gt;= #{fromTime}
      </if>
      <if test="toTime != null">
        and update_time &lt;= #{toTime}
      </if>
    </where>
  </sql>

  <select id="countContexts" resultType="long">
    select count(1)
    from chat_context_record
    <include refid="Context_Where"/>
  </select>

  <select id="selectContexts" resultType="io.github.jerryt92.j2agent.model.po.mgb.ChatContextRecord">
    select context_id as contextId,
           agent_id as agentId,
           title as title,
           user_id as userId,
           memory_version as memoryVersion,
           last_message_index as lastMessageIndex,
           update_time as updateTime
    from chat_context_record
    <include refid="Context_Where"/>
    <!-- context_id 经 Base64 且 -/_ 被替换，字符串序≠时间序；审计列表按最近更新倒序 -->
    order by update_time desc, context_id desc, agent_id desc
    limit #{limit} offset #{offset}
  </select>

</mapper>
